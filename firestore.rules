rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /shares/{shareSlug}
//   - Flashcards shared decks (shareSlug does NOT start with 'gorit-'):
//       Publicly readable by link; client-writable with schema validation; hard deletes forbidden.
//       Fields: shareSlug (string), title (string <= 500), cardCount (number 0..10000),
//               deckData (map), deleted (bool), deletedAt (number), updatedAt (number), createdAt (number)
//   - Gorit shared subjects (shareSlug matches '^gorit-[a-z0-9-]+$'):
//       Publicly readable by link; create/update restricted to verified Google Auth owner.
//       Fields: type ('gorit_subject'), shareSlug (string <= 100), title (string 1..500),
//               subjectData (map), sharedBy ({ uid, name }), createdAt (number > 0, immutable)
//
// Collection: /decks/{deckId}
//   - Private synced decks & notebooks (Pro Google users only, unless isShared == true for read).
//   - Fields: ownerUid (string == auth.uid, immutable), title (string <= 500 or null),
//             cardCount (number 0..10000), isFixed (bool), isExam (bool),
//             mode ('normal' | 'exam'), deckData (map), updatedAt (number), isShared (bool)
//
// Collection: /users/{userId}
//   - Private user sync document (Pro Google owner only; server Admin SDK manages billing/quota/email).
//   - Protected server-only fields: email, subscription, cambluClube, pro, extraGenerations,
//     monthlyGenerationsUsed, quotaLastResetMonth, freeAiDeckUsed, freeAiDeckUsedAt,
//     paidSessionIds, apiKey, apiKeyCreatedAt, apiKeyLastUsedAt,
//     dailyGoalWebhookUrl, dailyGoalWebhookLastTriggeredAt, dailyGoalWebhookLastTriggeredDate
//   - Client-writable sync fields: deckSlots, notebookSlot, settings, dailyStreak,
//     activeMode, lastSyncedAt, lastClientSyncId (+ legacy deleteField() cleanup of stats, slots, notebookData)
//
// Collection: /user_stats/{userId}
//   - Separated user statistics document (Pro Google owner only).
//   - Fields: ownerUid (string == auth.uid, immutable), stats (map), updatedAt (number),
//             lastClientSyncId (string <= 128 or null)
//
// Collection: /api_keys/{apiKey}
//   - Server-only API key index (Admin SDK only; never readable or writable by clients).
//
// Collection: /app_config/{docId}
//   - Server-only app configuration such as pro_whitelist (Admin SDK only; never readable or writable by clients).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Require verified Google Sign-In authentication
    function isGoogleAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // Helper: Require verified Google Sign-In with active Pro custom claim
    function isProGoogleUser() {
      return isGoogleAuth() && request.auth.token.pro == true;
    }

    // Helper: Check verified Google Pro ownership by userId path parameter
    function isProOwner(userId) {
      return isProGoogleUser() && request.auth.uid == userId;
    }

    // Helper: Protected server-only fields on /users/{userId}
    function protectedUserFields() {
      return [
        'email',
        'subscription',
        'cambluClube',
        'pro',
        'extraGenerations',
        'monthlyGenerationsUsed',
        'quotaLastResetMonth',
        'freeAiDeckUsed',
        'freeAiDeckUsedAt',
        'paidSessionIds',
        'apiKey',
        'apiKeyCreatedAt',
        'apiKeyLastUsedAt',
        'dailyGoalWebhookUrl',
        'dailyGoalWebhookLastTriggeredAt',
        'dailyGoalWebhookLastTriggeredDate'
      ];
    }

    // Helper: Allowed client-writable sync fields on /users/{userId}
    function allowedClientUserSyncFields() {
      return [
        'deckSlots',
        'notebookSlot',
        'stats',
        'slots',
        'notebookData',
        'settings',
        'dailyStreak',
        'activeMode',
        'lastSyncedAt',
        'lastClientSyncId'
      ];
    }

    // Validator: Client sync fields on /users/{userId}
    function isValidClientUserSync(data) {
      return (!('deckSlots' in data) || (data.deckSlots is list && data.deckSlots.size() <= 10))
        && (!('notebookSlot' in data) || data.notebookSlot == null || data.notebookSlot is map)
        && (!('settings' in data) || data.settings == null || data.settings is map)
        && (!('dailyStreak' in data) || data.dailyStreak == null || data.dailyStreak is map)
        && (!('activeMode' in data) || data.activeMode == null || (data.activeMode is string && data.activeMode.size() <= 32))
        && (!('lastSyncedAt' in data) || data.lastSyncedAt is number)
        && (!('lastClientSyncId' in data) || data.lastClientSyncId == null || (data.lastClientSyncId is string && data.lastClientSyncId.size() <= 128));
    }

    // Validator: Deck documents in /decks/{deckId}
    function isValidDeckDoc(data) {
      return data.keys().hasOnly([
          'ownerUid', 'title', 'cardCount', 'isFixed', 'isExam',
          'mode', 'deckData', 'updatedAt', 'isShared'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 500))
        && (!('cardCount' in data) || (data.cardCount is number && data.cardCount >= 0 && data.cardCount <= 10000))
        && (!('isFixed' in data) || data.isFixed is bool)
        && (!('isExam' in data) || data.isExam is bool)
        && (!('mode' in data) || (data.mode is string && data.mode in ['normal', 'exam']))
        && (!('updatedAt' in data) || data.updatedAt is number)
        && (!('isShared' in data) || data.isShared is bool);
    }

    // Validator: Separated stats documents in /user_stats/{userId}
    function isValidUserStatsDoc(data) {
      return data.keys().hasOnly(['ownerUid', 'stats', 'updatedAt', 'lastClientSyncId'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && (!('stats' in data) || data.stats is map)
        && (!('updatedAt' in data) || data.updatedAt is number)
        && (!('lastClientSyncId' in data) || data.lastClientSyncId == null || (data.lastClientSyncId is string && data.lastClientSyncId.size() <= 128));
    }

    // Validator: Flashcards shared deck writes (excludes gorit-* namespace)
    function isValidFlashcardsShare(shareSlug) {
      return !shareSlug.matches('^gorit-.*')
        && request.resource.data.keys().hasOnly([
          'shareSlug', 'title', 'cardCount', 'deckData',
          'deleted', 'deletedAt', 'updatedAt', 'createdAt'
        ])
        && (!('shareSlug' in request.resource.data) || (request.resource.data.shareSlug is string && request.resource.data.shareSlug == shareSlug))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 500))
        && (!('cardCount' in request.resource.data) || (request.resource.data.cardCount is number && request.resource.data.cardCount >= 0 && request.resource.data.cardCount <= 10000))
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);
    }

    // Validator: Gorit shared subject writes (verified Google owner only)
    function isValidGoritSubjectShare(shareSlug) {
      let data = request.resource.data;
      return isGoogleAuth()
        && data.keys().hasOnly(['type', 'shareSlug', 'title', 'subjectData', 'sharedBy', 'createdAt'])
        && data.keys().hasAll(['type', 'shareSlug', 'title', 'subjectData', 'sharedBy', 'createdAt'])
        && data.type == 'gorit_subject'
        && data.shareSlug is string
        && data.shareSlug == shareSlug
        && shareSlug.matches('^gorit-[a-z0-9-]+$')
        && shareSlug.size() <= 100
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 500
        && data.createdAt is number
        && data.createdAt > 0
        && data.sharedBy is map
        && data.sharedBy.keys().hasOnly(['uid', 'name'])
        && data.sharedBy.keys().hasAll(['uid', 'name'])
        && data.sharedBy.uid is string
        && data.sharedBy.uid == request.auth.uid
        && data.sharedBy.name is string
        && data.sharedBy.name.size() >= 1
        && data.sharedBy.name.size() <= 200
        && data.subjectData is map
        && data.subjectData.keys().hasOnly(['name', 'code', 'color', 'icon', 'emoji', 'contents'])
        && data.subjectData.keys().hasAll(['name', 'contents'])
        && data.subjectData.name is string
        && data.subjectData.name.size() >= 1
        && data.subjectData.name.size() <= 500
        && (!('code' in data.subjectData) || (data.subjectData.code is string && data.subjectData.code.size() <= 100))
        && (!('color' in data.subjectData) || (data.subjectData.color is string && data.subjectData.color.size() <= 50))
        && (!('icon' in data.subjectData) || (data.subjectData.icon is string && data.subjectData.icon.size() <= 100))
        && (!('emoji' in data.subjectData) || (data.subjectData.emoji is string && data.subjectData.emoji.size() <= 100))
        && data.subjectData.contents is list
        && data.subjectData.contents.size() <= 500;
    }

    // Shared decks (Flashcards) and shared subjects (Gorit) can be read publicly by anyone with the link.
    // Writes are schema-validated and hard deletes are forbidden (soft-delete only for Flashcards).
    match /shares/{shareSlug} {
      allow read: if true;
      allow create: if isValidFlashcardsShare(shareSlug)
        || isValidGoritSubjectShare(shareSlug);
      allow update: if (
          (!('type' in resource.data) || resource.data.type != 'gorit_subject')
          && isValidFlashcardsShare(shareSlug)
        ) || (
          'type' in resource.data
          && resource.data.type == 'gorit_subject'
          && isGoogleAuth()
          && 'sharedBy' in resource.data
          && resource.data.sharedBy is map
          && 'uid' in resource.data.sharedBy
          && resource.data.sharedBy.uid == request.auth.uid
          && isValidGoritSubjectShare(shareSlug)
          && request.resource.data.createdAt == resource.data.createdAt
        );
      allow delete: if false;
    }

    // Decks are strictly isolated to their Pro Google ownerUid (unless explicitly marked isShared == true for read)
    match /decks/{deckId} {
      allow get: if (resource != null && resource.data.isShared == true)
        || (isProGoogleUser() && (resource == null || resource.data.ownerUid == request.auth.uid));
      allow list: if (resource != null && resource.data.isShared == true)
        || (isProGoogleUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isProGoogleUser()
        && isValidDeckDoc(request.resource.data);
      allow update: if isProGoogleUser()
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && isValidDeckDoc(request.resource.data);
      allow delete: if isProGoogleUser()
        && resource.data.ownerUid == request.auth.uid;
    }

    // User private sync data (slots, streaks, settings) — Pro Google owner only.
    // Clients cannot create or mutate email, billing, quota, API key, or webhook fields.
    match /users/{userId} {
      allow read: if isProOwner(userId);
      allow create: if isProOwner(userId)
        && !request.resource.data.keys().hasAny(protectedUserFields())
        && request.resource.data.keys().hasOnly(allowedClientUserSyncFields())
        && isValidClientUserSync(request.resource.data);
      allow update: if isProOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedClientUserSyncFields())
        && isValidClientUserSync(request.resource.data);
      allow delete: if false;
    }

    // Separated user statistics document (Pro Google owner only; keeps /users/{userId} well below 1 MiB).
    match /user_stats/{userId} {
      allow read: if isProOwner(userId);
      allow create: if isProOwner(userId)
        && isValidUserStatsDoc(request.resource.data);
      allow update: if isProOwner(userId)
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && isValidUserStatsDoc(request.resource.data);
      allow delete: if isProOwner(userId)
        && resource != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // API keys mapping (only accessible via backend Admin Service Account)
    match /api_keys/{apiKey} {
      allow read, write: if false;
    }

    // Server-only app configuration (e.g. lifetime Pro whitelist) - NEVER readable or writable by clients
    match /app_config/{docId} {
      allow read, write: if false;
    }

    // Default deny for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
