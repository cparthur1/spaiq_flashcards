rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Protected server-only fields on /users/{userId}
    function protectedUserFields() {
      return [
        'subscription',
        'cambluClube',
        'pro',
        'extraGenerations',
        'monthlyGenerationsUsed',
        'quotaLastResetMonth',
        'freeAiDeckUsed',
        'freeAiDeckUsedAt',
        'paidSessionIds',
        'apiKey',
        'apiKeyCreatedAt',
        'apiKeyLastUsedAt',
        'dailyGoalWebhookUrl',
        'dailyGoalWebhookLastTriggeredAt',
        'dailyGoalWebhookLastTriggeredDate'
      ];
    }

    // Helper: Validate Flashcards shared deck writes (excludes gorit-* namespace)
    function isValidFlashcardsShare(shareSlug) {
      return !shareSlug.matches('^gorit-.*')
        && request.resource.data.keys().hasOnly([
          'shareSlug', 'title', 'cardCount', 'deckData',
          'deleted', 'deletedAt', 'updatedAt', 'createdAt'
        ])
        && (!('shareSlug' in request.resource.data) || (request.resource.data.shareSlug is string && request.resource.data.shareSlug == shareSlug))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 500))
        && (!('cardCount' in request.resource.data) || (request.resource.data.cardCount is number && request.resource.data.cardCount >= 0 && request.resource.data.cardCount <= 10000))
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);
    }

    // Helper: Validate Gorit shared subject writes (authenticated owner only)
    function isValidGoritSubjectShare(shareSlug) {
      let data = request.resource.data;
      return request.auth != null
        && data.keys().hasOnly(['type', 'shareSlug', 'title', 'subjectData', 'sharedBy', 'createdAt'])
        && data.keys().hasAll(['type', 'shareSlug', 'title', 'subjectData', 'sharedBy', 'createdAt'])
        && data.type == 'gorit_subject'
        && data.shareSlug is string
        && data.shareSlug == shareSlug
        && shareSlug.matches('^gorit-[a-z0-9-]+$')
        && shareSlug.size() <= 100
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 500
        && data.createdAt is number
        && data.createdAt > 0
        && data.sharedBy is map
        && data.sharedBy.keys().hasOnly(['uid', 'name'])
        && data.sharedBy.keys().hasAll(['uid', 'name'])
        && data.sharedBy.uid is string
        && data.sharedBy.uid == request.auth.uid
        && data.sharedBy.name is string
        && data.sharedBy.name.size() >= 1
        && data.sharedBy.name.size() <= 200
        && data.subjectData is map
        && data.subjectData.keys().hasOnly(['name', 'code', 'color', 'icon', 'emoji', 'contents'])
        && data.subjectData.keys().hasAll(['name', 'contents'])
        && data.subjectData.name is string
        && data.subjectData.name.size() >= 1
        && data.subjectData.name.size() <= 500
        && (!('code' in data.subjectData) || (data.subjectData.code is string && data.subjectData.code.size() <= 100))
        && (!('color' in data.subjectData) || (data.subjectData.color is string && data.subjectData.color.size() <= 50))
        && (!('icon' in data.subjectData) || (data.subjectData.icon is string && data.subjectData.icon.size() <= 100))
        && (!('emoji' in data.subjectData) || (data.subjectData.emoji is string && data.subjectData.emoji.size() <= 100))
        && data.subjectData.contents is list
        && data.subjectData.contents.size() <= 500;
    }

    // Shared decks (Flashcards) and shared subjects (Gorit) can be read publicly by anyone with the link.
    // Writes are schema-validated and hard deletes are forbidden (soft-delete only for Flashcards).
    match /shares/{shareSlug} {
      allow read: if true;
      allow create: if isValidFlashcardsShare(shareSlug)
        || isValidGoritSubjectShare(shareSlug);
      allow update: if (
          (!('type' in resource.data) || resource.data.type != 'gorit_subject')
          && isValidFlashcardsShare(shareSlug)
        ) || (
          'type' in resource.data
          && resource.data.type == 'gorit_subject'
          && request.auth != null
          && 'sharedBy' in resource.data
          && resource.data.sharedBy is map
          && 'uid' in resource.data.sharedBy
          && resource.data.sharedBy.uid == request.auth.uid
          && isValidGoritSubjectShare(shareSlug)
          && request.resource.data.createdAt == resource.data.createdAt
        );
      allow delete: if false;
    }

    // Decks are strictly isolated to their ownerUid (unless explicitly marked isShared == true for read)
    match /decks/{deckId} {
      allow get: if (resource != null && resource.data.isShared == true)
        || (request.auth != null && (resource == null || resource.data.ownerUid == request.auth.uid));
      allow list: if (resource != null && resource.data.isShared == true)
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 500));
      allow update: if request.auth != null
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 500));
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // User private data (slots, streaks, settings).
    // Clients cannot create or mutate billing, quota, API key, or webhook fields.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
      allow delete: if false;
    }

    // Separated user statistics document (keeps /users/{userId} well below the 1 MiB limit).
    match /user_stats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerUid', 'stats', 'updatedAt', 'lastClientSyncId'])
        && request.resource.data.ownerUid == request.auth.uid
        && (!('stats' in request.resource.data) || request.resource.data.stats is map)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
        && (!('lastClientSyncId' in request.resource.data) || (request.resource.data.lastClientSyncId is string && request.resource.data.lastClientSyncId.size() <= 128));
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'stats', 'updatedAt', 'lastClientSyncId'])
        && (!('stats' in request.resource.data) || request.resource.data.stats is map)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
        && (!('lastClientSyncId' in request.resource.data) || (request.resource.data.lastClientSyncId is string && request.resource.data.lastClientSyncId.size() <= 128));
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && resource != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // API keys mapping (only accessible via backend Admin Service Account)
    match /api_keys/{apiKey} {
      allow read, write: if false;
    }

    // Server-only app configuration (e.g. lifetime Pro whitelist) - NEVER readable or writable by clients
    match /app_config/{docId} {
      allow read, write: if false;
    }

    // Default deny for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
